<% root_node_uri = app_prefix("/repositories/#{params[:rid]}/resources/#{params[:id]}") %>

<div class="sidebar-information">
    <div class="sidebar-heading">
    <div class="record-sidebar-title">
        <h1>
        <a href="<%= app_prefix(resource_base_url(result)) %>"><%= result.parse_full_title(true).html_safe %></a>
        </h1>  
    </div>

    <div class="record-type-badge <%= result.primary_type %>">
        <i class="<%= icon_for_type(result.primary_type) %>"></i>&#160;<%= t("#{result.primary_type}._singular") %> <% if result.container_summary_for_badge %> &mdash; <%= result.container_summary_for_badge %><% end %>
    </div>
    </div>

    <div class="page_actions" title="<%= t('page_actions') %>">
        <%= render partial: 'shared/page_actions', locals: {:record => result, :title => result.display_string, :url => request.fullpath, :cite => result.cite} %>
    </div>
</div>

<ul class="resources-sidebar-links">
  <%= render partial: 'resources/resource_tab', locals: {:action => :show, :text => t('actions.collection_overview'),
                                                             :enabled => true, :hidden => false } %>
      <%= render partial: 'resources/resource_tab', locals: {:action => :infinite, :text => t('actions.hierarch'),
                                                             :enabled => @has_children, :hidden => false } %>
      <%= render partial: 'resources/resource_tab', locals: {:action => :inventory, :text => t('actions.numeric'),
                                                             :enabled => @has_containers, :hidden => AppConfig[:pui_hide][:container_inventory] } %>
      <%= render partial: 'resources/resource_tab', locals: {:action => :digitized, :text => t('actions.digitized'),
                                                             :enabled => @has_digital_objects, :hidden => !@has_digital_objects } %>
</ul>

<div class="search-sidebar"<% unless @has_children %>style="display: none"<% end %>>
    <h2 class="sidebar-h2">Search Within Collection</h2>
    <%= render partial: 'shared/search_collection_form', :locals => {:resource_uri => @result['uri'], :action_text => "#{t('actions.search_in', :type => t('resource._singular'))}"} %>
</div>

<div class="collection-organization"<% unless @has_children %>style="display: none"<% end %>>
  <%= render partial: 'shared/children_tree', :locals => {:heading_text => t('cont_arr'), :root_node_uri => @result.uri, :current_node_uri => @result.uri} %>
</div>
